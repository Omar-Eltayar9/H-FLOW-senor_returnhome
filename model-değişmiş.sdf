<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_lidar_down'>

    <self_collide>false</self_collide>

    <!-- X500 Drone -->
    <include merge='true'>
      <uri>x500</uri>
    </include>

    <!-- ===================================================== -->
    <!-- =================== FRONT LIDAR ===================== -->
    <!-- ===================================================== -->

    <link name="lidar_front_link">
      <pose relative_to="base_link">0.15 0 0.01 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
	
	
<visual name="lidar_front_visual">
  <pose>0.05 0 0 0 1.5707 0</pose>  <!-- X ekseninde uzansın -->
  <geometry>
    <cylinder>
      <radius>0.005</radius>
      <length>0.1</length>
    </cylinder>
  </geometry>
  <material>
    <ambient>1 0 0 1</ambient>
    <diffuse>1 0 0 1</diffuse>
  </material>
</visual>
      
      <sensor name='lidar_front' type='gpu_lidar'>
        <gz_frame_id>lidar_front_link</gz_frame_id>
        <pose>0 0 0 0 0 0</pose>
        <visualize>true</visualize>
        <update_rate>50</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>100.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>

    <joint name="lidar_front_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_front_link</child>
    </joint>

    <!-- ===================================================== -->
    <!-- =================== RIGHT LIDAR ===================== -->
    <!-- ===================================================== -->

    <link name="lidar_right_link">
    	<pose relative_to="base_link">0.01 -0.10 0.01 0 0 -1.57</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>


<visual name="lidar_front_visual">
  <pose>0.05 0 0 0 1.5707 0</pose>  <!-- X ekseninde uzansın -->
  <geometry>
    <cylinder>
      <radius>0.005</radius>
      <length>0.1</length>
    </cylinder>
  </geometry>
  <material>
    <ambient>1 0 0 1</ambient>
    <diffuse>1 0 0 1</diffuse>
  </material>
</visual>

      <sensor name='lidar_right' type='gpu_lidar'>
        <gz_frame_id>lidar_right_link</gz_frame_id>
        <pose>0 0 0 0 0 0</pose>
        <update_rate>50</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>100.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>

    <joint name="lidar_right_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_right_link</child>
    </joint>

    <!-- ===================================================== -->
    <!-- =================== LEFT LIDAR ====================== -->
    <!-- ===================================================== -->

    <link name="lidar_left_link">
    	<pose relative_to="base_link">0.01 0.10 0.01 0 0 1.57</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
	
	
<visual name="lidar_front_visual">
  <pose>0.05 0 0 0 1.5707 0</pose>  <!-- X ekseninde uzansın -->
  <geometry>
    <cylinder>
      <radius>0.005</radius>
      <length>0.1</length>
    </cylinder>
  </geometry>
  <material>
    <ambient>1 0 0 1</ambient>
    <diffuse>1 0 0 1</diffuse>
  </material>
</visual>
	
      <sensor name='lidar_left' type='gpu_lidar'>
        <gz_frame_id>lidar_left_link</gz_frame_id>
        <pose>0 0 0 0 0 0</pose>
        <update_rate>50</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>100.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>

    <joint name="lidar_left_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_left_link</child>
    </joint>

  </model>
</sdf>

